{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fermentation recipe v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "gravity_unit", "steps"],
  "properties": {
    "version": {"const": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 48},
    "gravity_unit": {"enum": ["sg", "plato"]},
    "gravity_confirm_samples": {"type": "integer", "minimum": 1, "maximum": 10, "default": 3},
    "on_complete": {"const": "hold", "default": "hold"},
    "steps": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "target_c", "max_days"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 48},
          "target_c": {"type": "number", "minimum": -55, "maximum": 125},
          "max_days": {"type": "number", "minimum": 0.000011574074074074074, "maximum": 365},
          "gravity_limit": {"type": ["number", "null"]}
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"gravity_unit": {"const": "sg"}}},
     "then": {"properties": {"steps": {"items": {"properties": {
       "gravity_limit": {"type": ["number", "null"], "minimum": 0.8, "maximum": 1.5}
     }}}}}},
    {"if": {"properties": {"gravity_unit": {"const": "plato"}}},
     "then": {"properties": {"steps": {"items": {"properties": {
       "gravity_limit": {"type": ["number", "null"], "minimum": -10, "maximum": 50}
     }}}}}}
  ]
}
